{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/spravochnik.html",
      "destination": "/spravochnik/",
      "permanent": true
    },
    {
      "source": "/pages/forum.html",
      "destination": "/forum/",
      "permanent": true
    },
    {
      "source": "/pages/ai-agent.html",
      "destination": "/ai-agent/",
      "permanent": true
    },
    {
      "source": "/pages/mini-services.html",
      "destination": "/mini-services/",
      "permanent": true
    },
    {
      "source": "/pages/playground.html",
      "destination": "/playground/",
      "permanent": true
    },
    {
      "source": "/pages/board.html",
      "destination": "/board/",
      "permanent": true
    },
    {
      "source": "/pages/support.html",
      "destination": "/support/",
      "permanent": true
    },
    {
      "source": "/pages/privacy.html",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/pages/terms.html",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/pages/admin/admin.html",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/pages/admin/gms-ide.html",
      "destination": "/admin/gms-ide/",
      "permanent": true
    },
    {
      "source": "/pages/admin/hierarchy-editor.html",
      "destination": "/admin/hierarchy-editor/",
      "permanent": true
    },
    {
      "source": "/pages/admin/review.html",
      "destination": "/admin/review/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/translate",
      "destination": "/api/seo?kind=translate"
    },
    {
      "source": "/api/topics",
      "destination": "/api/seo?kind=topics"
    },
    {
      "source": "/api/example",
      "destination": "/api/repo?op=example"
    },
    {
      "source": "/api/examples",
      "destination": "/api/repo?op=examples"
    },
    {
      "source": "/api/file",
      "destination": "/api/repo?op=file"
    },
    {
      "source": "/api/gemini",
      "destination": "/api/relay?op=gemini"
    },
    {
      "source": "/api/llm",
      "destination": "/api/relay?op=llm"
    },
    {
      "source": "/",
      "destination": "/pages/home.html"
    },
    {
      "source": "/spravochnik/",
      "destination": "/pages/spravochnik.html"
    },
    {
      "source": "/spravochnik/:id/",
      "destination": "/api/seo?kind=topic&id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?kind=sitemap"
    },
    {
      "source": "/forum/",
      "destination": "/pages/forum.html"
    },
    {
      "source": "/ai-agent/",
      "destination": "/pages/ai-agent.html"
    },
    {
      "source": "/mini-services/",
      "destination": "/pages/mini-services.html"
    },
    {
      "source": "/playground/",
      "destination": "/pages/playground.html"
    },
    {
      "source": "/board/",
      "destination": "/pages/board.html"
    },
    {
      "source": "/support/",
      "destination": "/pages/support.html"
    },
    {
      "source": "/privacy/",
      "destination": "/pages/privacy.html"
    },
    {
      "source": "/terms/",
      "destination": "/pages/terms.html"
    },
    {
      "source": "/admin/",
      "destination": "/pages/admin/admin.html"
    },
    {
      "source": "/admin/gms-ide/",
      "destination": "/pages/admin/gms-ide.html"
    },
    {
      "source": "/admin/hierarchy-editor/",
      "destination": "/pages/admin/hierarchy-editor.html"
    },
    {
      "source": "/admin/review/",
      "destination": "/pages/admin/review.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/lib/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/i18n/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/review-notes.js": {
      "maxDuration": 60,
      "includeFiles": "data/topics/config.json"
    },
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "data/topics/config.json"
    },
    "api/simplify.js": {
      "maxDuration": 60
    },
    "api/ai-task.js": {
      "maxDuration": 60
    },
    "api/forum-moderate.js": {
      "maxDuration": 60
    },
    "api/seo.js": {
      "maxDuration": 60,
      "includeFiles": "data/topics/config.json"
    },
    "api/relay.js": {
      "maxDuration": 60
    }
  }
}
