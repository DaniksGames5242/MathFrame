# This .gitignore file is recommended for Unity projects on GitHub.
# More info: https://github.com/github/gitignore/blob/main/Unity.gitignore

# ================
# Unity generated
# ================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# ===============
# Visual Studio / MonoDevelop / Rider / JetBrains
# ===============
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Rider specific
.idea/
*.sln.iml
.DS_Store

# ===============
# Compiled / binaries
# ===============
*.dll
*.exe
*.so
*.dylib
*.pdb
*.mdb

# ===============
# OS generated
# ===============
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp
*.log
*.cache

# ===============
# Unity specific
# ===============
# Unity3D built files
*.unity3d
*.assetbundle
*.apk
*.aab
*.xcode
*.ipa

# Crash reports
crashlytics-build.properties
[Cc]rashlytics/

# Addressable assets data
[Ll]ibrary/[Aa]ddressable[Aa]ssets[Dd]ata/

# Autogenerated JetBrains Rider plugin
/Assets/Plugins/Editor/JetBrains*

# Visual Studio Code
.vscode/

# Gradle cache
.gradle/

# Android
android-*/
Android[Ll]ibs/
[Bb]in/[Dd]ebug/
[Bb]in/[Rr]elease/
[Oo]bj/[Dd]ebug/
[Oo]bj/[Rr]elease/

# iOS
[Tt]emp[iI][Oo][Ss]/
[Bb]uild/
[iI][Oo][Ss]/

# macOS specific
*.DS_Store
*.app

# Windows specific
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Linux specific
*.so

# ===============
# Unity Package Manager
# ===============
/Library/PackageCache/
/Library/ArtifactDB
/Packages/packages-lock.json   # optionally, if you want to commit lock file, remove this line
/Logs/

# ===============
# Scriptable Build Pipeline
# ===============
/[Uu]ser[Ss]ettings/AssetBundle*

# ===============
# ProBuilder
# ===============
/Assets/ProBuilder Data/
/Assets/ProBuilder Data About/