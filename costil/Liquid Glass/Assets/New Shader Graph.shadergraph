{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "f3ed87b532ef4bd581461afca8e491b9",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "BoxBlur_float (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1270.400146484375,
            "y": -367.199951171875,
            "width": 229.60009765625,
            "height": 165.5999755859375
        }
    },
    "m_Slots": [
        {
            "m_Id": "3208b3278b1c4d688ccb83ed7d34092d"
        },
        {
            "m_Id": "0dc2aa64c8614e1584c8c1cde0047293"
        },
        {
            "m_Id": "5aa30b1b9bd54915a2a814a9c91bf4a5"
        },
        {
            "m_Id": "41da4d2702d24d3fbc8136ba0f4a1176"
        },
        {
            "m_Id": "566780b6c875415a9a3329faa5abcafe"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BoxBlur_float",
    "m_FunctionSource": "e726f92aa11718b4a8ec2fef3ba26dfa",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "if (blurSize <= 0.001) {\r\n    color = tex.Sample(samplerTex, uv);\r\n    return;\r\n}\r\n\r\nfloat4 sum = 0;\r\nint count = 0;\r\n[unroll]\r\nfor (int x = -4; x <= 4; x++) {\r\n    [unroll]\r\n    for (int y = -4; y <= 4; y++) {\r\n        float2 offset = float2(x, y) * blurSize;\r\n        sum += tex.Sample(samplerTex, uv + offset);\r\n        count++;\r\n    }\r\n}\r\ncolor = sum / count;"
}

