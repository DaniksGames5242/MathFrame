list off = [0, 4, 12, 18, 38]; list eo = [0, 6, 18, 30, 60]; list ecount = [6, 12, 12, 30, 30]; list fcount = [3, 4, 3, 5, 3];
Function num(x, d) { if (x < 0) { return "−" + format(-x, d); } return format(x, d); }
Function pick(p, q) {
  if (p == 3 && q == 3) { return 0; } if (p == 4 && q == 3) { return 1; } if (p == 3 && q == 4) { return 2; }
  if (p == 5 && q == 3) { return 3; } if (p == 3 && q == 5) { return 4; } return -1;
}
Function sname(s) { if (s == 0) { return "тетраэдр"; } if (s == 1) { return "куб (гексаэдр)"; } if (s == 2) { return "октаэдр"; } if (s == 3) { return "додекаэдр"; } return "икосаэдр"; }
Function setv(P, i) { P.pos.x = px[i] * a; P.pos.y = py[i] * a; P.pos.z = pz[i] * a; }
Function layout() {
  float o = off[sol]; float e = eo[sol];
  if (0 < ne) { setv(EA0, o + ea[e + 0]); setv(EB0, o + eb[e + 0]); ef0 = 1; } else { ef0 = 0; }
  if (1 < ne) { setv(EA1, o + ea[e + 1]); setv(EB1, o + eb[e + 1]); ef1 = 1; } else { ef1 = 0; }
  if (2 < ne) { setv(EA2, o + ea[e + 2]); setv(EB2, o + eb[e + 2]); ef2 = 1; } else { ef2 = 0; }
  if (3 < ne) { setv(EA3, o + ea[e + 3]); setv(EB3, o + eb[e + 3]); ef3 = 1; } else { ef3 = 0; }
