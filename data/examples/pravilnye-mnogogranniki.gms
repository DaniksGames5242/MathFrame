Update {
  p = round(p); q = round(q);
  sol = pick(p, q);
  float ang = (p - 2) * 180 / p; float sum = q * ang;
  float ok = 0; if (sol > -0.5) { ok = 1; }
  float k = sol * 1000 + a * 10;
  if (k != key) {
    key = k;
    if (ok > 0.5) {
      ne = ecount[sol]; nfp = fcount[sol]; nq = q;
      layout();
    } else { ne = 0; nfp = 0; nq = 0; ef0 = 0; ef1 = 0; ef2 = 0; ef3 = 0; ef4 = 0; ef5 = 0; ef6 = 0; ef7 = 0; ef8 = 0; ef9 = 0; ef10 = 0; ef11 = 0; ef12 = 0; ef13 = 0; ef14 = 0; ef15 = 0; ef16 = 0; ef17 = 0; ef18 = 0; ef19 = 0; ef20 = 0; ef21 = 0; ef22 = 0; ef23 = 0; ef24 = 0; ef25 = 0; ef26 = 0; ef27 = 0; ef28 = 0; ef29 = 0; }
  }
  gf0 = 0; nf0 = 0; if (ok > 0.5) { if (0 < nfp) { gf0 = 1; } if (0 < q) { nf0 = 1; } }
  gf1 = 0; nf1 = 0; if (ok > 0.5) { if (1 < nfp) { gf1 = 1; } if (1 < q) { nf1 = 1; } }
  gf2 = 0; nf2 = 0; if (ok > 0.5) { if (2 < nfp) { gf2 = 1; } if (2 < q) { nf2 = 1; } }
  gf3 = 0; nf3 = 0; if (ok > 0.5) { if (3 < nfp) { gf3 = 1; } if (3 < q) { nf3 = 1; } }
  gf4 = 0; nf4 = 0; if (ok > 0.5) { if (4 < nfp) { gf4 = 1; } if (4 < q) { nf4 = 1; } }
  info = "**Условие.** Грани — правильные " + format(p, 0) + "-угольники, угол каждого " + format(ang, 1) + "°; в вершине сходятся " + format(q, 0) + " граней, сумма плоских углов при вершине " + format(q, 0) + "·" + format(ang, 1) + "° = **" + format(sum, 1) + "°**. ";
  if (ok < 0.5) {
    if (sum < 359.99) { info = info + "Сумма меньше 360°, но такое сочетание не даёт замкнутого тела с равными гранями и вершинами: среди допустимых остаются только пять."; }
    else { info = info + "Сумма не меньше 360° — из таких углов нельзя составить выпуклый многогранный угол (при 360° грани ложатся в плоскость). Правильного многогранника нет."; }
    info = info + "

Правильных многогранников ровно пять: (p, q) = (3, 3), (4, 3), (3, 4), (5, 3), (3, 5)."; }
  else {
    float e = 2 * p * q / (2 * p + 2 * q - p * q); float v = 2 * e / q; float f = 2 * e / p;
    float x = cos(3.141593 / q) / sin(3.141593 / p); float y = sqrt(1 - x * x);
    float s = f * p * a * a / (4 * tan(3.141593 / p));
    float r = a / 2 / tan(3.141593 / p) * x / y; float rr = a / 2 * tan(3.141593 / q) * x / y;
    info = info + "Сумма меньше 360° — вершина выпуклая, тело замыкается: **" + sname(sol) + "**.

";
    info = info + "Вершин V = " + format(v, 0) + ", рёбер E = " + format(e, 0) + ", граней F = " + format(f, 0) + ": V − E + F = " + format(v - e + f, 0) + " (формула Эйлера). Двойственный — (p, q) = (" + format(q, 0) + ", " + format(p, 0) + "): **" + sname(pick(q, p)) + "**.

";
    info = info + "При ребре a = " + format(a, 1) + ": площадь поверхности **" + format(s, 2) + "**, объём **" + format(s * r / 3, 2) + "**, радиус вписанной сферы " + format(r, 2) + ", описанной " + format(rr, 2) + ", двугранный угол " + format(2 * acos(y) * 57.29578, 2) + "°. Жёлтым выделена грань, синим — рёбра одной вершины.";
  }
}
]
