  if (13 < ne) { setv(EA13, o + ea[e + 13]); setv(EB13, o + eb[e + 13]); ef13 = 1; } else { ef13 = 0; }
  if (14 < ne) { setv(EA14, o + ea[e + 14]); setv(EB14, o + eb[e + 14]); ef14 = 1; } else { ef14 = 0; }
