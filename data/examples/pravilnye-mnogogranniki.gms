  if (26 < ne) { setv(EA26, o + ea[e + 26]); setv(EB26, o + eb[e + 26]); ef26 = 1; } else { ef26 = 0; }
  if (27 < ne) { setv(EA27, o + ea[e + 27]); setv(EB27, o + eb[e + 27]); ef27 = 1; } else { ef27 = 0; }
  if (28 < ne) { setv(EA28, o + ea[e + 28]); setv(EB28, o + eb[e + 28]); ef28 = 1; } else { ef28 = 0; }
  if (29 < ne) { setv(EA29, o + ea[e + 29]); setv(EB29, o + eb[e + 29]); ef29 = 1; } else { ef29 = 0; }
  if (0 < nfp + 0.5) { setv(G0, o + fv[sol * 6 + 0 - nfp * floor(0 / nfp)]); }
  if (1 < nfp + 0.5) { setv(G1, o + fv[sol * 6 + 1 - nfp * floor(1 / nfp)]); }
  if (2 < nfp + 0.5) { setv(G2, o + fv[sol * 6 + 2 - nfp * floor(2 / nfp)]); }
