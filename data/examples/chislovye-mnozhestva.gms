[
description = "{info}"
field width = 20; field height = 4;
camera type = fixed;
show axes = true;
string sel = "3"; string info = "";
new Point { name = "P"; pos = (3, 0); dynamic = false; collision = false; color = #3b82f6 }
new UI { type = select; label = "число"; variable = sel; options = ("−4", "0", "3", "1/2", "1.5", "√2", "π"); labels = ("−4", "0", "3", "1/2", "1.5", "√2", "π"); default = "3" }
Update {
  float v = 3; string sets = "целое, рациональное, действительное";
  if (sel == "−4") { v = -4; sets = "целое, рациональное, действительное"; }
  if (sel == "0") { v = 0; sets = "натуральное расширенное (0), целое, рациональное, действительное"; }
  if (sel == "3") { v = 3; sets = "натуральное, целое, рациональное, действительное"; }
  if (sel == "1/2") { v = 0.5; sets = "рациональное, действительное (не целое)"; }
  if (sel == "1.5") { v = 1.5; sets = "рациональное, действительное (не целое)"; }
  if (sel == "√2") { v = 1.4142; sets = "иррациональное, действительное (не рациональное)"; }
  if (sel == "π") { v = 3.1416; sets = "иррациональное, действительное (не рациональное)"; }
  P.pos.x = v;
  info = "**Числовые множества** образуют цепочку N ⊂ Z ⊂ Q ⊂ R: каждое следующее включает предыдущее. Выбранное число " + sel + " принадлежит множествам: " + sets + ".";
}
]
